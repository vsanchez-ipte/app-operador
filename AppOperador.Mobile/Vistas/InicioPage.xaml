<?xml version="1.0" encoding="utf-8" ?>
<!--
    Tablero de Inicio: identidad, estado de enlace y los cuatro indicadores operativos.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppOperador.Mobile.ViewModels"
             x:Class="AppOperador.Mobile.Vistas.InicioPage"
             x:DataType="vm:InicioViewModel"
             Style="{StaticResource PaginaOperador}"
             Title="Inicio">

    <ScrollView>
        <VerticalStackLayout Padding="14" Spacing="12">

            <!--
                Aviso permanente de modo offline (JTT-1383 CA 7 y 8). El literal es el que
                fija JTT-279 y no se reformula. El boton fuerza la revalidacion sin esperar
                a que el sistema note el cambio de enlace.
            -->
            <Border IsVisible="{Binding Enlace.EnModoOffline}" Style="{StaticResource Tarjeta}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                        <Label Text="{Binding Enlace.Texto}" FontAttributes="Bold"
                               TextColor="{StaticResource AmbarTexto}" />
                        <!--
                            Hasta cuando se admite trabajo sin conexion (JTT-1386 CA 4). Lleva la
                            fecha y no solo la hora: la ventana puede vencer al dia siguiente. El
                            instante lo calculo el servidor y aqui solo se pasa a hora local.
                        -->
                        <Label Text="{Binding Enlace.ExpiraEl, StringFormat='Trabajo sin conexión permitido hasta el {0}'}"
                               Style="{StaticResource TextoSecundario}"
                               IsVisible="{Binding Enlace.HayExpiracion}" />
                        <Label Text="{Binding Enlace.Detalle}" Style="{StaticResource TextoSecundario}"
                               IsVisible="{Binding Enlace.HayDetalle}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Reintentar" Style="{StaticResource BotonSecundario}"
                            Command="{Binding Enlace.ReintentarCommand}"
                            IsEnabled="{Binding Enlace.PuedeReintentar}" />
                </Grid>
            </Border>

            <!-- Cabecera: quién trabaja y si hay enlace con Jacob CCO -->
            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="1">
                            <!--
                                Titulo neutro a proposito. Antes decia "Operador de campo", que
                                cualquiera leia como el rol sin serlo: el rol real venia en la
                                sesion y no se mostraba en ninguna pantalla.
                            -->
                            <Label Text="Sesión activa" Style="{StaticResource TituloTarjeta}" />
                            <Label Text="Modo vehicular · Campo"
                                   Style="{StaticResource TextoSecundario}" />
                        </VerticalStackLayout>

                        <!--
                            Estado de la comunicacion con Jacob CCO (JTT-1386 CA 2). Son cuatro
                            insignias excluyentes y no una con el color enlazado: en este proyecto
                            el fondo de un Border se pinta con brocha desde un estilo, y elegir el
                            estilo por disparadores sobre un enum obliga a acrobacias en XAML.

                            El verde exige comunicacion exitosa con Jacob, no que el telefono
                            tenga red (CA 10 y CA 11). Antes la insignia se quedaba verde aunque
                            dijera OFFLINE.
                        -->
                        <Border Grid.Column="1" Style="{StaticResource InsigniaVerde}"
                                IsVisible="{Binding Enlace.EstaEnLinea}">
                            <Label Text="{Binding Enlace.TextoEstado}" Style="{StaticResource TextoInsigniaVerde}" />
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource InsigniaAmbar}"
                                IsVisible="{Binding Enlace.EstaSinConexion}">
                            <Label Text="{Binding Enlace.TextoEstado}" Style="{StaticResource TextoInsigniaAmbar}" />
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource InsigniaRosa}"
                                IsVisible="{Binding Enlace.EstaRevalidando}">
                            <Label Text="{Binding Enlace.TextoEstado}" Style="{StaticResource TextoInsigniaRosa}" />
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource InsigniaRoja}"
                                IsVisible="{Binding Enlace.EstaEnErrorDeServicio}">
                            <Label Text="{Binding Enlace.TextoEstado}" Style="{StaticResource TextoInsigniaRoja}" />
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource TarjetaInterna}">
                        <Grid ColumnDefinitions="*,Auto">
                            <!--
                                Identidad y unidad, todo desde la sesion (JTT-1386 CA 1 y CA 9).
                                Van etiquetados para que se puedan verificar sin adivinar cual es
                                cual: el rol de un operador puede parecer un nombre.
                            -->
                            <VerticalStackLayout Grid.Column="0" Spacing="1">
                                <Label Text="{Binding Operador}" FontAttributes="Bold" FontSize="14"
                                       TextColor="{StaticResource TextoTitulo}" />
                                <Label Text="{Binding Rol, StringFormat='Rol: {0}'}"
                                       Style="{StaticResource TextoSecundario}" />
                                <!-- Unidad con la que opera (JTT-1381 CA 13). Es la clave, no el id tecnico. -->
                                <Label Text="{Binding UnidadVehicular, StringFormat='Unidad {0}'}"
                                       Style="{StaticResource TextoSecundario}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="End">
                                <!--
                                    Solo si la sesión autoriza capturar. Estaba fija y decía
                                    «CAPTURA» hasta con un operador sin permiso; al lado del
                                    nombre y del rol, eso se lee como una afirmación sobre él.
                                -->
                                <Border Style="{StaticResource InsigniaRosa}"
                                        IsVisible="{Binding PuedeCapturar}">
                                    <Label Text="CAPTURA" Style="{StaticResource TextoInsigniaRosa}" />
                                </Border>
                                <Label Text="{Binding HoraActualizacion}"
                                       Style="{StaticResource TextoSecundario}" FontSize="10"
                                       HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Captura operativa" Style="{StaticResource TituloTarjeta}" />
                    <Label Text="Registro offline de incidencias de campo, evidencia y sincronizacion."
                           Style="{StaticResource TextoSecundario}" />
                </VerticalStackLayout>
            </Border>

            <!-- Los cuatro indicadores del vistazo rápido -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Tarjeta}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Pendientes sync" Style="{StaticResource TextoSecundario}" />
                        <Label Text="{Binding Resumen.PendientesSincronizar}" Style="{StaticResource ValorIndicador}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Tarjeta}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="KM actual" Style="{StaticResource TextoSecundario}" />
                        <Label Text="{Binding KilometroActual}" Style="{StaticResource ValorIndicador}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Tarjeta}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Avisos" Style="{StaticResource TextoSecundario}" />
                        <Label Text="{Binding Resumen.Avisos}" Style="{StaticResource ValorIndicador}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Tarjeta}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Evidencia local" Style="{StaticResource TextoSecundario}" />
                        <Label Text="{Binding Resumen.EvidenciaLocal}" Style="{StaticResource ValorIndicador}" />
                    </VerticalStackLayout>
                </Border>

            </Grid>

            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Ultimos avisos" Style="{StaticResource TituloTarjeta}" />
                    <Label Text="Sin avisos operativos." Style="{StaticResource TextoSecundario}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
