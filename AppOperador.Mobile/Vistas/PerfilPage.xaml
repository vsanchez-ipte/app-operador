<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppOperador.Mobile.ViewModels"
             x:Class="AppOperador.Mobile.Vistas.PerfilPage"
             x:DataType="vm:PerfilViewModel"
             Style="{StaticResource PaginaOperador}"
             Title="Perfil">

    <Grid>
    <ScrollView>
        <VerticalStackLayout Padding="14" Spacing="12">

            <!-- Literal fijado por Producto; el botón fuerza la revalidación -->
            <Border IsVisible="{Binding Enlace.EnModoOffline}" Style="{StaticResource Tarjeta}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                        <Label Text="{Binding Enlace.Texto}" FontAttributes="Bold"
                               TextColor="{StaticResource AmbarTexto}" />
                        <Label Text="{Binding Enlace.Detalle}" Style="{StaticResource TextoSecundario}"
                               IsVisible="{Binding Enlace.HayDetalle}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Reintentar" Style="{StaticResource BotonSecundario}"
                            Command="{Binding Enlace.ReintentarCommand}"
                            IsEnabled="{Binding Enlace.PuedeReintentar}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="10">

                    <Label Text="Sesion y permisos" Style="{StaticResource TituloTarjeta}" />

                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                          RowSpacing="8">

                        <Label Grid.Row="0" Grid.Column="0" Text="Operador" Style="{StaticResource TextoSecundario}" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding Operador}"
                               FontAttributes="Bold" FontSize="13" TextColor="{StaticResource TextoTitulo}" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Unidad vehicular" Style="{StaticResource TextoSecundario}" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding UnidadVehicular}"
                               FontAttributes="Bold" FontSize="13" TextColor="{StaticResource TextoTitulo}" />

                        <Label Grid.Row="2" Grid.Column="0" Text="Sesion offline" Style="{StaticResource TextoSecundario}" />
                        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource InsigniaVerde}">
                            <Label Text="{Binding EstadoVigencia}" Style="{StaticResource TextoInsigniaVerde}" />
                        </Border>

                        <Label Grid.Row="3" Grid.Column="0" Text="Expira" Style="{StaticResource TextoSecundario}" />
                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding HoraExpiracion}"
                               FontAttributes="Bold" FontSize="13" TextColor="{StaticResource TextoTitulo}" />

                        <Label Grid.Row="4" Grid.Column="0" Text="Version APK" Style="{StaticResource TextoSecundario}" />
                        <Label Grid.Row="4" Grid.Column="1" Text="{Binding VersionAplicacion}"
                               FontAttributes="Bold" FontSize="13" TextColor="{StaticResource TextoTitulo}" />

                        <Label Grid.Row="5" Grid.Column="0" Text="Catalogos" Style="{StaticResource TextoSecundario}" />
                        <Label Grid.Row="5" Grid.Column="1" Text="{Binding VersionCatalogos}"
                               FontAttributes="Bold" FontSize="13" TextColor="{StaticResource TextoTitulo}" />

                        <Label Grid.Row="6" Grid.Column="0" Text="Modo" Style="{StaticResource TextoSecundario}" />
                        <Border Grid.Row="6" Grid.Column="1" Style="{StaticResource InsigniaVerde}">
                            <Label Text="{Binding Modo}" Style="{StaticResource TextoInsigniaVerde}" />
                        </Border>

                    </Grid>

                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Permisos}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Style="{StaticResource InsigniaVerde}">
                                    <Label Text="{Binding .}" Style="{StaticResource TextoInsigniaVerde}" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>

                    <!-- Arriba, los módulos del token; aquí, lo que el operador puede hacer con ellos -->
                    <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding Capacidades}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:CapacidadVista">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="{Binding Nombre}" Style="{StaticResource TextoSecundario}" />
                                    <Label Grid.Column="1" Text="{Binding Estado}"
                                           FontAttributes="Bold" FontSize="13" TextColor="{StaticResource TextoTitulo}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Button Text="Cerrar sesion"
                            Style="{StaticResource BotonSecundario}"
                            Command="{Binding CerrarSesionCommand}" />

                </VerticalStackLayout>
            </Border>

            <!-- Nunca dice «enviada»: mientras el CCO no confirme, el archivo solo existe aquí -->
            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="10">

                    <Label Text="Almacenamiento local" Style="{StaticResource TituloTarjeta}" />

                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">
                        <Label Grid.Row="0" Grid.Column="0" Text="Espacio del dispositivo" Style="{StaticResource TextoSecundario}" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding EspacioLibre}"
                               FontAttributes="Bold" FontSize="13" TextColor="{StaticResource TextoTitulo}" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Evidencias" Style="{StaticResource TextoSecundario}" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding TextoEvidenciasPendientes}"
                               FontAttributes="Bold" FontSize="13" TextColor="{StaticResource TextoTitulo}" />
                    </Grid>

                    <VerticalStackLayout Spacing="4"
                                         IsVisible="{Binding HayEvidenciasPendientes}"
                                         BindableLayout.ItemsSource="{Binding EvidenciasPendientes}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:EvidenciaPendienteVista">
                                <Label Text="{Binding Texto}"
                                       Style="{StaticResource TextoSecundario}"
                                       LineBreakMode="MiddleTruncation" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="10">

                    <Label Text="Auditoria" Style="{StaticResource TituloTarjeta}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Eventos}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:EventoAuditoriaVista">
                                <Border Style="{StaticResource TarjetaInterna}">
                                    <VerticalStackLayout Spacing="2">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <Label Grid.Column="0" Text="{Binding FechaHoraLocal}"
                                                   FontAttributes="Bold" FontSize="13"
                                                   TextColor="{StaticResource TextoTitulo}" />
                                            <Label Grid.Column="1" Text="{Binding TextoOrigen}"
                                                   Style="{StaticResource TextoSecundario}"
                                                   IsVisible="{Binding HayOrigen}"
                                                   VerticalOptions="Center" />
                                            <!-- BackgroundColor y no Background: al enlazar, la cadena se convierte a Color pero no a brocha -->
                                            <Border Grid.Column="2"
                                                    BackgroundColor="{Binding ColorFondoNivel}"
                                                    Stroke="Transparent" StrokeShape="RoundRectangle 4"
                                                    Padding="8,3" VerticalOptions="Center">
                                                <Label Text="{Binding TextoNivel}"
                                                       FontSize="10" FontAttributes="Bold"
                                                       TextColor="{Binding ColorTextoNivel}" />
                                            </Border>
                                        </Grid>
                                        <Label Text="{Binding Mensaje}" Style="{StaticResource TextoDato}" />
                                        <Label Text="{Binding Contexto}"
                                               Style="{StaticResource TextoSecundario}"
                                               FontSize="11" LineBreakMode="WordWrap"
                                               IsVisible="{Binding HayContexto}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- De quince en quince: se conserva más de lo que se lee de una vez -->
                    <Button Text="Ver mas"
                            Style="{StaticResource BotonSecundario}"
                            Command="{Binding VerMasEventosCommand}"
                            IsVisible="{Binding HayMasEventos}" />

                </VerticalStackLayout>
            </Border>

            <!-- Solo en paquetes con HabilitarExportacionBaseDatos; el XAML no se preprocesa, así que se oculta con la propiedad -->
            <Border IsVisible="{Binding PuedeExportarBaseDatos}" Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="10">

                    <Label Text="Diagnostico" Style="{StaticResource TituloTarjeta}" />

                    <Label Style="{StaticResource TextoSecundario}"
                           Text="Guarda una copia de la base local en formato SQLite para revisarla en el equipo. La copia queda SIN CIFRAR e incluye incidencias, operador, unidad y bitacora." />

                    <Button Text="Exportar base de datos"
                            Style="{StaticResource BotonSecundario}"
                            Command="{Binding ExportarBaseDatosCommand}" />

                </VerticalStackLayout>
            </Border>

            <!-- Solo en paquetes con HabilitarCopiaToken: permite a QA autorizarse en Swagger -->
            <Border IsVisible="{Binding PuedeCopiarToken}" Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="10">

                    <Label Text="Token de sesion" Style="{StaticResource TituloTarjeta}" />

                    <Label Style="{StaticResource TextoSecundario}"
                           Text="Copia el token de esta sesion para pegarlo en el boton Authorize de Swagger. Es la CREDENCIAL de la sesion: quien la tenga puede actuar como este operador hasta que la sesion termine." />

                    <Button Text="Copiar token de sesion"
                            Style="{StaticResource BotonSecundario}"
                            Command="{Binding CopiarTokenCommand}" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

        <!-- Capa encima de todo: dentro del scroll quedaba escondida -->
        <Grid IsVisible="{Binding Cargando}"
              BackgroundColor="#B3E8DED0"
              InputTransparent="False">
            <Border Style="{StaticResource Tarjeta}"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    Padding="24,18">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding Cargando}"
                                       Color="{StaticResource Vino}"
                                       HeightRequest="36" WidthRequest="36"
                                       HorizontalOptions="Center" />
                    <Label Text="Cargando…"
                           Style="{StaticResource TextoSecundario}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>

</ContentPage>
