<?xml version="1.0" encoding="utf-8" ?>
<!--
    Pantalla de acceso (JTT-279). Una sola pantalla con credenciales, unidad del catálogo
    y estado de comunicación, como la maqueta.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppOperador.Mobile.ViewModels"
             x:Class="AppOperador.Mobile.Vistas.AccesoPage"
             x:DataType="vm:AccesoViewModel"
             Style="{StaticResource PaginaOperador}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- Franja de identidad, presente en todas las pantallas de la maqueta -->
        <VerticalStackLayout Grid.Row="0" BackgroundColor="{StaticResource Blanco}" Padding="16,10" Spacing="2">
            <Label Text="APK OPERADOR DE CAMPO" Style="{StaticResource TituloBanner}" />
            <Label Text="Offline-first · Captura de evidencia · Cola local y sincronizacion"
                   Style="{StaticResource TextoSecundario}" FontSize="10" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <Grid Padding="20,32" RowDefinitions="Auto">

                <VerticalStackLayout Spacing="16" VerticalOptions="Center" MaximumWidthRequest="420">

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Jacob CCO" FontSize="22" FontAttributes="Bold"
                               TextColor="{StaticResource TextoTitulo}" HorizontalOptions="Center" />
                        <Label Text="Operador de campo - Tijuana-Mexicali"
                               Style="{StaticResource TextoSecundario}" HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <Border Style="{StaticResource Tarjeta}">
                        <VerticalStackLayout Spacing="14">

                            <!--
                                Contra Jacob CCO la credencial es el CORREO, no un nombre de
                                usuario: el API autentica por email y esa decisión está cerrada.
                                La etiqueta cambia con el modo para no pedir un dato equivocado.
                            -->
                            <VerticalStackLayout IsVisible="{Binding MostrarCredenciales}">
                                <Label Text="{Binding EtiquetaUsuario}" Style="{StaticResource EtiquetaCampo}" />
                                <Border Style="{StaticResource MarcoCampo}">
                                    <Entry Style="{StaticResource CampoTexto}"
                                           Placeholder="{Binding EjemploUsuario}"
                                           Keyboard="{Binding TecladoUsuario}"
                                           Text="{Binding Usuario}" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout IsVisible="{Binding MostrarCredenciales}">
                                <Label Text="CONTRASEÑA" Style="{StaticResource EtiquetaCampo}" />
                                <Border Style="{StaticResource MarcoCampo}">
                                    <Entry Style="{StaticResource CampoTexto}"
                                           IsPassword="True"
                                           Text="{Binding Contrasena}" />
                                </Border>
                            </VerticalStackLayout>

                            <!--
                                Selección del catálogo: JTT-279 no admite texto libre y
                                JTT-1381 exige que el ID salga del catálogo, nunca del
                                teclado. Contra el simulador se ve desde el principio, como
                                en la maqueta; contra el API real aparece en el segundo paso,
                                cuando la preautenticación ya devolvió las unidades reales
                                del operador.
                            -->
                            <VerticalStackLayout IsVisible="{Binding MostrarSelectorUnidad}">
                                <Label Text="UNIDAD VEHICULAR" Style="{StaticResource EtiquetaCampo}" />
                                <Border Style="{StaticResource MarcoCampo}">
                                    <Picker Style="{StaticResource CampoLista}"
                                            ItemsSource="{Binding Unidades}"
                                            SelectedItem="{Binding UnidadSeleccionada}" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- Mensaje de rechazo: literal y persistente junto al formulario -->
                            <Label Text="{Binding MensajeError}"
                                   Style="{StaticResource MensajeError}"
                                   IsVisible="{Binding HayError}" />

                            <!--
                                Ubicación (JTT-1380). El literal de arriba lo fija JTT-279 y
                                es igual para los seis estados; estos dos elementos son los
                                que distinguen cuál se encontró y qué puede hacer el operador.
                                Sin ellos, "Active la ubicación..." no dice si hay que
                                conceder un permiso, desbloquearlo o encender el GPS.
                            -->
                            <Label Text="{Binding DetalleUbicacion}"
                                   Style="{StaticResource TextoSecundario}"
                                   IsVisible="{Binding HayDetalleUbicacion}" />

                            <Button Text="{Binding TextoAccionUbicacion}"
                                    Style="{StaticResource BotonSecundario}"
                                    Command="{Binding EjecutarAccionUbicacionCommand}"
                                    IsVisible="{Binding HayAccionUbicacion}"
                                    IsEnabled="{Binding Ocupado, Converter={StaticResource InvertirBooleano}}" />

                            <!-- Confirmación de la preautenticación. No muestra el desafío. -->
                            <Label Text="{Binding MensajeAviso}"
                                   Style="{StaticResource TextoSecundario}"
                                   TextColor="{StaticResource VerdeTexto}"
                                   FontAttributes="Bold"
                                   IsVisible="{Binding HayAviso}" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Button Grid.Column="0"
                                        Text="{Binding TextoBotonAcceso}"
                                        Style="{StaticResource BotonPrimario}"
                                        Command="{Binding IngresarCommand}"
                                        IsEnabled="{Binding Ocupado, Converter={StaticResource InvertirBooleano}}" />
                                <Button Grid.Column="1"
                                        Text="Continuar offline"
                                        Style="{StaticResource BotonSecundario}"
                                        Command="{Binding ContinuarSinConexionCommand}"
                                        IsEnabled="{Binding Ocupado, Converter={StaticResource InvertirBooleano}}" />
                            </Grid>

                            <!--
                                Salida del segundo paso. Sin ella la pantalla es un callejón
                                sin salida: el desafío vence a los cinco minutos y el operador
                                tendría que cerrar la app para reintentar.
                            -->
                            <Button Text="Cambiar de cuenta"
                                    Style="{StaticResource BotonSecundario}"
                                    Command="{Binding VolverACredencialesCommand}"
                                    IsVisible="{Binding EnSeleccionDeUnidad}"
                                    IsEnabled="{Binding Ocupado, Converter={StaticResource InvertirBooleano}}" />

                        </VerticalStackLayout>
                    </Border>

                    <Label Text="{Binding TextoEstadoEnlace}"
                           Style="{StaticResource TextoSecundario}"
                           HorizontalOptions="Center" />

                </VerticalStackLayout>
            </Grid>
        </ScrollView>
    </Grid>

</ContentPage>
