<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppOperador.Mobile.ViewModels"
             x:Class="AppOperador.Mobile.Vistas.AccesoPage"
             x:DataType="vm:AccesoViewModel"
             Style="{StaticResource PaginaOperador}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <VerticalStackLayout Grid.Row="0" BackgroundColor="{StaticResource Blanco}" Padding="16,10" Spacing="2">
            <Label Text="APK OPERADOR DE CAMPO" Style="{StaticResource TituloBanner}" />
            <Label Text="Offline-first · Captura de evidencia · Cola local y sincronizacion"
                   Style="{StaticResource TextoSecundario}" FontSize="10" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <Grid Padding="20,32" RowDefinitions="Auto">

                <VerticalStackLayout Spacing="16" VerticalOptions="Center" MaximumWidthRequest="420">

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Jacob CCO" FontSize="22" FontAttributes="Bold"
                               TextColor="{StaticResource TextoTitulo}" HorizontalOptions="Center" />
                        <Label Text="Operador de campo - Tijuana-Mexicali"
                               Style="{StaticResource TextoSecundario}" HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <Border Style="{StaticResource Tarjeta}">
                        <VerticalStackLayout Spacing="14">

                            <!-- Contra Jacob se pide el correo: el API autentica por email -->
                            <VerticalStackLayout IsVisible="{Binding MostrarCredenciales}">
                                <Label Text="{Binding EtiquetaUsuario}" Style="{StaticResource EtiquetaCampo}" />
                                <Border Style="{StaticResource MarcoCampo}">
                                    <Entry Style="{StaticResource CampoTexto}"
                                           Placeholder="{Binding EjemploUsuario}"
                                           Keyboard="{Binding TecladoUsuario}"
                                           Text="{Binding Usuario}" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout IsVisible="{Binding MostrarCredenciales}">
                                <Label Text="CONTRASEÑA" Style="{StaticResource EtiquetaCampo}" />
                                <Border Style="{StaticResource MarcoCampo}">
                                    <Entry Style="{StaticResource CampoTexto}"
                                           IsPassword="True"
                                           Text="{Binding Contrasena}" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- Solo del catálogo, nunca texto libre. Tarjetas y no Picker: el Picker no muestra el estado ni deshabilita opciones -->
                            <VerticalStackLayout IsVisible="{Binding MostrarSelectorUnidad}" Spacing="8">
                                <Label Text="UNIDAD VEHICULAR" Style="{StaticResource EtiquetaCampo}" />
                                <!-- Altura fija para tres tarjetas y media: la que asoma avisa que hay más, y la pantalla no crece con el catálogo -->
                                <Border Style="{StaticResource MarcoCampo}" Padding="6">
                                    <ScrollView MaximumHeightRequest="330" VerticalScrollBarVisibility="Always">
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Unidades}" Spacing="8">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="vm:OpcionUnidadVista">
                                                    <Border Style="{StaticResource TarjetaInterna}"
                                                            Stroke="{Binding PincelBorde}"
                                                            Background="{Binding PincelFondo}"
                                                            StrokeThickness="{Binding GrosorBorde}"
                                                            Opacity="{Binding Opacidad}">
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer
                                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AccesoViewModel}}, Path=SeleccionarUnidadCommand}"
                                                                CommandParameter="{Binding .}" />
                                                        </Border.GestureRecognizers>
                                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                            <Ellipse Grid.Column="0"
                                                                     Fill="{Binding PincelEstado}"
                                                                     WidthRequest="12"
                                                                     HeightRequest="12"
                                                                     VerticalOptions="Center" />
                                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                                <Label Text="{Binding Clave}" FontAttributes="Bold" FontSize="14"
                                                                       TextColor="{StaticResource TextoTitulo}" />
                                                                <Label Text="{Binding Descripcion}" Style="{StaticResource TextoDato}"
                                                                       IsVisible="{Binding HayDescripcion}" />
                                                                <Label Text="{Binding TextoEstado}" Style="{StaticResource TextoSecundario}" />
                                                            </VerticalStackLayout>
                                                            <Label Grid.Column="2"
                                                                   Text="✓ Elegida"
                                                                   FontAttributes="Bold"
                                                                   FontSize="12"
                                                                   TextColor="{StaticResource Vino}"
                                                                   VerticalOptions="Center"
                                                                   IsVisible="{Binding Seleccionada}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </ScrollView>
                                </Border>
                                <Label Text="{Binding TextoCantidadUnidades}"
                                       Style="{StaticResource TextoSecundario}"
                                       IsVisible="{Binding HayMasUnidadesQueLasVisibles}" />
                                <Label Text="{Binding TextoSincronizacion}"
                                       Style="{StaticResource TextoSecundario}"
                                       IsVisible="{Binding HayTextoSincronizacion}" />
                            </VerticalStackLayout>

                            <Label Text="{Binding MensajeError}"
                                   Style="{StaticResource MensajeError}"
                                   IsVisible="{Binding HayError}" />

                            <!-- El literal es igual para todos los estados; el detalle y el botón dicen cuál ocurrió y qué hacer -->
                            <Label Text="{Binding DetalleUbicacion}"
                                   Style="{StaticResource TextoSecundario}"
                                   IsVisible="{Binding HayDetalleUbicacion}" />

                            <Button Text="{Binding TextoAccionUbicacion}"
                                    Style="{StaticResource BotonSecundario}"
                                    Command="{Binding EjecutarAccionUbicacionCommand}"
                                    IsVisible="{Binding HayAccionUbicacion}"
                                    IsEnabled="{Binding Ocupado, Converter={StaticResource InvertirBooleano}}" />

                            <!-- Siempre que la ubicación bloquee: dos estados no ofrecen otra acción -->
                            <Button Text="{Binding TextoRevalidarUbicacion}"
                                    Style="{StaticResource BotonSecundario}"
                                    Command="{Binding RevalidarUbicacionCommand}"
                                    IsVisible="{Binding PuedeRevalidarUbicacion}"
                                    IsEnabled="{Binding Ocupado, Converter={StaticResource InvertirBooleano}}" />

                            <!-- No muestra el desafío -->
                            <Label Text="{Binding MensajeAviso}"
                                   Style="{StaticResource TextoSecundario}"
                                   TextColor="{StaticResource VerdeTexto}"
                                   FontAttributes="Bold"
                                   IsVisible="{Binding HayAviso}" />

                            <!-- Los botones apagados no bastan: sin esto la pantalla parece colgada -->
                            <HorizontalStackLayout Spacing="10"
                                                   HorizontalOptions="Center"
                                                   IsVisible="{Binding HayPasoEnCurso}">
                                <ActivityIndicator IsRunning="{Binding HayPasoEnCurso}"
                                                   Color="{StaticResource Vino}"
                                                   HeightRequest="18"
                                                   WidthRequest="18"
                                                   VerticalOptions="Center" />
                                <Label Text="{Binding PasoEnCurso}"
                                       Style="{StaticResource TextoSecundario}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <!-- Si Android mató el proceso, la sesión sigue guardada: se avisa -->
                            <Label Text="{Binding AvisoSesionGuardada}"
                                   Style="{StaticResource TextoSecundario}"
                                   IsVisible="{Binding HaySesionGuardada}" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Button Grid.Column="0"
                                        Text="{Binding TextoBotonAcceso}"
                                        Style="{StaticResource BotonPrimario}"
                                        Command="{Binding IngresarCommand}"
                                        IsEnabled="{Binding Ocupado, Converter={StaticResource InvertirBooleano}}" />
                                <Button Grid.Column="1"
                                        Text="Continuar offline"
                                        Style="{StaticResource BotonSecundario}"
                                        Command="{Binding ContinuarSinConexionCommand}"
                                        IsEnabled="{Binding Ocupado, Converter={StaticResource InvertirBooleano}}" />
                            </Grid>

                            <!-- Sin esta salida, el desafío vence y el operador tendría que cerrar la app -->
                            <Button Text="Cambiar de cuenta"
                                    Style="{StaticResource BotonSecundario}"
                                    Command="{Binding VolverACredencialesCommand}"
                                    IsVisible="{Binding EnSeleccionDeUnidad}"
                                    IsEnabled="{Binding Ocupado, Converter={StaticResource InvertirBooleano}}" />

                        </VerticalStackLayout>
                    </Border>

                    <Label Text="{Binding TextoEstadoEnlace}"
                           Style="{StaticResource TextoSecundario}"
                           HorizontalOptions="Center" />

                </VerticalStackLayout>
            </Grid>
        </ScrollView>
    </Grid>

</ContentPage>
