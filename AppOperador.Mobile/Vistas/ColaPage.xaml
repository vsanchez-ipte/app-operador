<?xml version="1.0" encoding="utf-8" ?>
<!--
    Cola local de registros pendientes (JTT-290) y su sincronización (JTT-291).
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppOperador.Mobile.ViewModels"
             x:Class="AppOperador.Mobile.Vistas.ColaPage"
             x:DataType="vm:ColaViewModel"
             Style="{StaticResource PaginaOperador}"
             Title="Cola">

    <Grid>
    <ScrollView>
        <VerticalStackLayout Padding="14" Spacing="12">

            <!--
                Aviso permanente de modo offline (JTT-1383 CA 7 y 8). El literal es el que
                fija JTT-279 y no se reformula. El boton fuerza la revalidacion sin esperar
                a que el sistema note el cambio de enlace.
            -->
            <Border IsVisible="{Binding Enlace.EnModoOffline}" Style="{StaticResource Tarjeta}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                        <Label Text="{Binding Enlace.Texto}" FontAttributes="Bold"
                               TextColor="{StaticResource AmbarTexto}" />
                        <Label Text="{Binding Enlace.Detalle}" Style="{StaticResource TextoSecundario}"
                               IsVisible="{Binding Enlace.HayDetalle}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Reintentar" Style="{StaticResource BotonSecundario}"
                            Command="{Binding Enlace.ReintentarCommand}"
                            IsEnabled="{Binding Enlace.PuedeReintentar}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Cola offline" Style="{StaticResource TituloTarjeta}" />
                        <Border Grid.Column="1" Style="{StaticResource InsigniaVerde}">
                            <Label Text="{Binding Pendientes}" Style="{StaticResource TextoInsigniaVerde}" />
                        </Border>
                    </Grid>

                    <Label Text="{Binding TextoPendientes}" Style="{StaticResource TextoSecundario}" />

                    <Button Text="Sincronizar ahora"
                            Style="{StaticResource BotonPrimario}"
                            Command="{Binding SincronizarCommand}"
                            IsEnabled="{Binding Ocupado, Converter={StaticResource InvertirBooleano}}" />

                    <!-- Qué pasó en la última sincronización (JTT-1401 CA 10). Va JUNTO al
                         botón: sin esto, pulsar sin enlace no produce ningún cambio visible y
                         el operador no distingue un botón que no respondió de una cola que no
                         tenía nada que enviar, así que acaba pulsando en bucle. -->
                    <Label Text="{Binding MensajeSincronizacion}"
                           Style="{StaticResource TextoSecundario}"
                           IsVisible="{Binding HayMensajeSincronizacion}" />

                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="10">

                    <Label Text="Cola de registros" Style="{StaticResource TituloTarjeta}" />

                    <Label Text="Sin registros en cola."
                           Style="{StaticResource TextoSecundario}"
                           IsVisible="{Binding HayRegistros, Converter={StaticResource InvertirBooleano}}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Registros}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:RegistroColaVista">
                                <Border Style="{StaticResource TarjetaInterna}">
                                    <VerticalStackLayout Spacing="4">

                                        <Grid ColumnDefinitions="*,Auto">
                                            <!-- Referencia principal (JTT-1403 CA 1): el folio en
                                                 cuanto Jacob confirma, y la clave local mientras
                                                 no. Cual de los dos es lo decide RegistroCola, no
                                                 esta vista. -->
                                            <Label Grid.Column="0" Text="{Binding ReferenciaPrincipal}"
                                                   FontAttributes="Bold" FontSize="14"
                                                   TextColor="{StaticResource TextoTitulo}" />

                                            <Border Grid.Column="1"
                                                    BackgroundColor="{Binding ColorFondoEstado}"
                                                    Stroke="Transparent" StrokeShape="RoundRectangle 4"
                                                    Padding="8,3" VerticalOptions="Center">
                                                <Label Text="{Binding TextoEstado}"
                                                       FontSize="10" FontAttributes="Bold"
                                                       TextColor="{Binding ColorTextoEstado}" />
                                            </Border>
                                        </Grid>

                                        <Label Text="{Binding TextoDatos}" Style="{StaticResource TextoDato}" />

                                        <!-- Cuando se capturo (JTT-290 CA 3). Es la hora de
                                             captura, la misma que viaja al CCO, y no la del
                                             ultimo cambio de estado. -->
                                        <Label Text="{Binding TextoHora}"
                                               Style="{StaticResource TextoSecundario}"
                                               IsVisible="{Binding MuestraHora}" />

                                        <!-- Trazabilidad (JTT-1403 CA 2): con el folio arriba, la
                                             clave local baja aqui en vez de desaparecer. Es la
                                             unica referencia comun con la base del dispositivo. -->
                                        <Label Text="{Binding TextoTrazabilidad}"
                                               Style="{StaticResource TextoDato}"
                                               IsVisible="{Binding MuestraTrazabilidad}" />

                                        <!-- Por que no salio ESTE registro. El resumen de arriba
                                             cuenta cuantas hay de cada clase; con varias fallidas
                                             a la vez no dice cual es cual ni que corregir. El
                                             texto lo compone RegistroCola, no esta vista. -->
                                        <Label Text="{Binding TextoMotivoFallo}"
                                               Style="{StaticResource TextoSecundario}"
                                               TextColor="{StaticResource RojoTexto}"
                                               IsVisible="{Binding MuestraMotivoFallo}" />

                                        <!-- Cuando toca el proximo intento. Solo en los fallos
                                             tecnicos: un rechazo funcional no se reintenta solo,
                                             y anunciarle una hora seria prometer algo que no va
                                             a pasar. La espera crece con cada fallo, asi que no
                                             se puede dar por sabida. -->
                                        <Label Text="{Binding TextoReintento}"
                                               Style="{StaticResource TextoSecundario}"
                                               TextColor="{StaticResource AmbarTexto}"
                                               IsVisible="{Binding MuestraReintento}" />

                                        <!-- Corregir un rechazo (JTT-291 CA 8). Solo en los
                                             rechazos funcionales: son los que no saldran solos
                                             y los que el operador puede arreglar. Lleva al
                                             formulario con el registro cargado. -->
                                        <Button Text="Corregir y reenviar"
                                                Style="{StaticResource BotonSecundario}"
                                                HorizontalOptions="End"
                                                IsVisible="{Binding MuestraCorregir}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ColaViewModel}}, Path=CorregirCommand}"
                                                CommandParameter="{Binding .}" />

                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

        <!-- Capa de carga, centrada y encima de todo. Al entrar a la pestana la pantalla
             tarda unos segundos en estar lista y sin esto parece que no responde. Va como
             capa y no dentro del scroll: arriba del todo quedaba escondida. -->
        <Grid IsVisible="{Binding Cargando}"
              BackgroundColor="#B3E8DED0"
              InputTransparent="False">
            <Border Style="{StaticResource Tarjeta}"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    Padding="24,18">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding Cargando}"
                                       Color="{StaticResource Vino}"
                                       HeightRequest="36" WidthRequest="36"
                                       HorizontalOptions="Center" />
                    <Label Text="Cargando…"
                           Style="{StaticResource TextoSecundario}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>

</ContentPage>
