<?xml version="1.0" encoding="utf-8" ?>
<!--
    Captura de incidencia de campo (JTT-280) y su evidencia (JTT-289).
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AppOperador.Mobile.ViewModels"
             x:Class="AppOperador.Mobile.Vistas.CapturaPage"
             x:DataType="vm:CapturaViewModel"
             Style="{StaticResource PaginaOperador}"
             Title="Captura">

    <ScrollView>
        <VerticalStackLayout Padding="14" Spacing="12">

            <!--
                Aviso permanente de modo offline (JTT-1383 CA 7 y 8). El literal es el que
                fija JTT-279 y no se reformula. El boton fuerza la revalidacion sin esperar
                a que el sistema note el cambio de enlace.
            -->
            <Border IsVisible="{Binding Enlace.EnModoOffline}" Style="{StaticResource Tarjeta}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                        <Label Text="{Binding Enlace.Texto}" FontAttributes="Bold"
                               TextColor="{StaticResource AmbarTexto}" />
                        <Label Text="{Binding Enlace.Detalle}" Style="{StaticResource TextoSecundario}"
                               IsVisible="{Binding Enlace.HayDetalle}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Reintentar" Style="{StaticResource BotonSecundario}"
                            Command="{Binding Enlace.ReintentarCommand}"
                            IsEnabled="{Binding Enlace.PuedeReintentar}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="14">

                    <Label Text="Registro de incidencia" Style="{StaticResource TituloTarjeta}" />

                    <VerticalStackLayout>
                        <Label Text="TIPO DE INCIDENCIA" Style="{StaticResource EtiquetaCampo}" />
                        <Border Style="{StaticResource MarcoCampo}">
                            <Picker Style="{StaticResource CampoLista}"
                                    ItemsSource="{Binding Tipos}"
                                    SelectedItem="{Binding TipoSeleccionado}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Kilómetro y gravedad van lado a lado, como en la maqueta -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

                        <VerticalStackLayout Grid.Column="0">
                            <!-- La etiqueta dice de dónde salió el kilómetro, no las opciones (JTT-1393 CA 6) -->
                            <Label Text="{Binding EtiquetaKilometro}" Style="{StaticResource EtiquetaCampo}" />
                            <Border Style="{StaticResource MarcoCampo}">
                                <Entry Style="{StaticResource CampoTexto}"
                                       Placeholder="Ej. 130+400"
                                       Text="{Binding Kilometro}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="SEVERIDAD" Style="{StaticResource EtiquetaCampo}" />
                            <Border Style="{StaticResource MarcoCampo}">
                                <Picker Style="{StaticResource CampoLista}"
                                        ItemsSource="{Binding Severidades}"
                                        SelectedItem="{Binding SeveridadSeleccionada}" />
                            </Border>
                        </VerticalStackLayout>

                    </Grid>

                    <!-- JTT-1395 CA 11: se puede pedir una lectura nueva antes de guardar.

                         El aviso NO usa el estilo de error, por la misma razon que el aviso de
                         sincronizacion de JTT-1401: ninguno de los cinco motivos es un fallo del
                         operador ni le impide capturar, porque el campo del KM siempre se puede
                         teclear. Estar fuera del corredor es lo normal en el acceso a la caseta,
                         y que a un tramo le falte geometria es una carencia del sistema. Pintarlo
                         en rojo enseña a ignorar los mensajes rojos, y el dia que uno importe no
                         se leeria. -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0"
                               Text="{Binding AvisoGps}"
                               Style="{StaticResource TextoSecundario}"
                               IsVisible="{Binding HayAvisoGps}"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Text="Recalcular ubicación"
                                Style="{StaticResource BotonSecundario}"
                                Command="{Binding RecalcularUbicacionCommand}" />
                    </Grid>

                    <VerticalStackLayout>
                        <Label Text="NOTA DEL OPERADOR" Style="{StaticResource EtiquetaCampo}" />
                        <Border Style="{StaticResource MarcoCampo}">
                            <!-- El tope lo pone el ViewModel, que es de donde sale el contador (JTT-1393 CA 7) -->
                            <Editor Style="{StaticResource CampoNota}"
                                    Placeholder="Descripcion de la incidencia..."
                                    MaxLength="{Binding LongitudMaximaNota}"
                                    Text="{Binding Nota}" />
                        </Border>
                        <Label Text="{Binding ContadorNota}"
                               Style="{StaticResource TextoSecundario}"
                               FontSize="10"
                               HorizontalOptions="End"
                               Margin="0,4,0,0" />
                    </VerticalStackLayout>

                    <Label Text="{Binding MensajeError}"
                           Style="{StaticResource MensajeError}"
                           IsVisible="{Binding HayError}" />

                    <!-- Falta descargar el catálogo (JTT-1394 CA 2). Sin él no hay tipos ni
                         severidades que ofrecer, y en blanco pareceria que la app fallo. -->
                    <Label Text="{Binding AvisoSinCatalogo}"
                           Style="{StaticResource MensajeError}"
                           IsVisible="{Binding HayAvisoSinCatalogo}" />

                    <!-- ===== Evidencia (JTT-1398 CA 1) =====

                         Va ANTES de los botones de guardar porque el criterio dice «adjuntar
                         evidencia opcional ANTES de guardar»: si estuviera después, el
                         operador leería el orden al revés.

                         La lista muestra nombre, tipo y tamaño de cada archivo, que son los
                         tres datos que el PO pidió visibles, y deja quitarlos.
                    -->
                    <Label Text="EVIDENCIA (OPCIONAL)" Style="{StaticResource EtiquetaCampo}" />

                    <!-- El visor de la maqueta, ahora con contenido. Antes era decorativo
                         —una elipse sobre un fondo oscuro— y los botones que lo acompañaban
                         estaban muertos, mientras otro juego de botones vivos hacía lo mismo
                         más arriba. Es un solo bloque: se mira aquí y se actúa aquí.

                         Muestra lo adjuntado, no la cámara en vivo: capturar se delega a la
                         app de cámara del sistema, que ya trae enfoque, flash y HDR, y es lo
                         que hace que el permiso se pida al usar la función (CA 3). -->
                    <Border BackgroundColor="#1E1A1A" StrokeThickness="0" Padding="12"
                            HeightRequest="170" StrokeShape="RoundRectangle 8">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="CAM-MOVIL" FontSize="10" TextColor="#C9BFB6" />
                                <!-- Contador combinado, sin separar fotos de videos: así lo fijó el PO. -->
                                <Label Grid.Column="1" Text="{Binding ContadorEvidencias}"
                                       FontSize="10" FontAttributes="Bold"
                                       TextColor="{StaticResource RosaFondo}" />
                            </Grid>

                            <!-- Sin nada adjunto se conserva la elipse de la maqueta: el
                                 recuadro vacío y negro se lee como que algo falló. -->
                            <VerticalStackLayout Grid.Row="1" Spacing="6"
                                                 HorizontalOptions="Center" VerticalOptions="Center"
                                                 IsVisible="{Binding HayEvidencias, Converter={StaticResource InvertirBooleano}}">
                                <Ellipse WidthRequest="56" HeightRequest="56"
                                         Stroke="#8A7F78" StrokeThickness="2"
                                         HorizontalOptions="Center" />
                                <Label Text="Sin evidencia adjunta" FontSize="10"
                                       TextColor="#8A7F78" HorizontalOptions="Center" />
                            </VerticalStackLayout>

                            <ScrollView Grid.Row="1" Orientation="Horizontal"
                                        HorizontalScrollBarVisibility="Never"
                                        IsVisible="{Binding HayEvidencias}"
                                        VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="8"
                                                       BindableLayout.ItemsSource="{Binding Evidencias}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:EvidenciaVista">
                                            <Border WidthRequest="72" HeightRequest="72"
                                                    BackgroundColor="#2B2523" StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 6">
                                                <Grid>
                                                    <Image Source="{Binding Ruta}" Aspect="AspectFill"
                                                           IsVisible="{Binding EsImagen}" />
                                                    <!-- Un PDF o un video no tienen miniatura sin
                                                         decodificarlos, y decodificar quince
                                                         megabytes para un cuadro de 72 píxeles no
                                                         compra nada. Se muestra el tipo. -->
                                                    <Label Text="{Binding Etiqueta}"
                                                           FontSize="11" FontAttributes="Bold"
                                                           TextColor="#C9BFB6"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center"
                                                           IsVisible="{Binding EsImagen, Converter={StaticResource InvertirBooleano}}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </HorizontalStackLayout>
                            </ScrollView>

                            <Label Grid.Row="2" Text="{Binding Kilometro, StringFormat='KM {0}'}"
                                   FontSize="10" TextColor="#C9BFB6" />
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <!-- La cámara solo si el dispositivo la tiene: ofrecer un botón que no
                             puede funcionar es peor que no ofrecerlo. -->
                        <Button Grid.Column="0"
                                Text="Capturar foto"
                                Style="{StaticResource BotonPrimario}"
                                IsVisible="{Binding HayCamara}"
                                IsEnabled="{Binding PuedeAdjuntar}"
                                Command="{Binding AdjuntarDeCamaraCommand}" />
                        <!-- Queda visible y apagado mientras el catálogo no publique un
                             video/*, y se enciende solo el día que lo haga: es el mismo trato
                             que a los otros tres límites. Ocultarlo dejaría JTT-289 con trabajo
                             de app que hoy no hace falta. -->
                        <Button Grid.Column="1"
                                Text="Capturar video corto"
                                Style="{StaticResource BotonSecundario}"
                                IsVisible="{Binding HayCamara}"
                                IsEnabled="{Binding PuedeAdjuntarVideo}"
                                Command="{Binding AdjuntarDeVideoCommand}" />
                    </Grid>

                    <!-- El selector de archivos es la otra mitad del CA 2, «selector de archivos
                         o fotografías». Sin él, el PDF que el servidor admite no tenía por dónde
                         entrar: la galería solo ofrece el carrete. -->
                    <Button Text="Elegir archivo"
                            Style="{StaticResource BotonSecundario}"
                            IsEnabled="{Binding PuedeAdjuntar}"
                            Command="{Binding AdjuntarDeArchivoCommand}" />

                    <!-- La unica salida cuando el permiso de camara quedo bloqueado: desde la
                         aplicacion ya no se puede volver a pedir, asi que sin este boton el
                         operador se queda pulsando foto y video sin que ocurra nada. Solo
                         aparece en ese caso; una negativa normal se resuelve volviendo a
                         tocar el boton. -->
                    <Button Text="Abrir configuración de la aplicación"
                            Style="{StaticResource BotonSecundario}"
                            IsVisible="{Binding OfreceAjustesDeCamara}"
                            Command="{Binding AbrirAjustesDeCamaraCommand}" />

                    <!-- Por qué el botón de video está apagado. Va junto a él por lo mismo que
                         el aviso de permiso: un botón visible y muerto sin explicación se lee
                         como que la app está rota. -->
                    <Label Text="{Binding AvisoVideo}"
                           Style="{StaticResource TextoSecundario}"
                           IsVisible="{Binding HayAvisoVideo}" />

                    <VerticalStackLayout Spacing="6" IsVisible="{Binding HayEvidencias}"
                                         BindableLayout.ItemsSource="{Binding Evidencias}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:EvidenciaVista">
                                <Border Style="{StaticResource TarjetaInterna}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="1">
                                            <Label Text="{Binding Nombre}"
                                                   Style="{StaticResource TextoDato}"
                                                   LineBreakMode="MiddleTruncation" />
                                            <Label Style="{StaticResource TextoSecundario}">
                                                <Label.Text>
                                                    <MultiBinding StringFormat="{}{0} · {1}">
                                                        <Binding Path="Tipo" />
                                                        <Binding Path="Tamano" />
                                                    </MultiBinding>
                                                </Label.Text>
                                            </Label>
                                        </VerticalStackLayout>

                                        <!-- No se puede quitar lo que el CCO ya confirmó: el
                                             archivo existe del otro lado. -->
                                        <Button Grid.Column="1"
                                                Text="Quitar"
                                                Style="{StaticResource BotonSecundario}"
                                                IsEnabled="{Binding YaEnviada, Converter={StaticResource InvertirBooleano}}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CapturaViewModel}}, Path=QuitarEvidenciaCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Por qué los botones están apagados (JTT-1404 CA 5). Va JUNTO a
                         ellos y no arriba del formulario: el operador mira el botón que no
                         responde, y ahí es donde tiene que encontrar la explicación. -->
                    <Label Text="{Binding AvisoSinPermiso}"
                           Style="{StaticResource MensajeError}"
                           IsVisible="{Binding HayAvisoSinPermiso}" />

                    <!-- Qué borrador se está editando (JTT-1399 CA 8). Sin esto, el
                         formulario relleno es indistinguible de una captura nueva y el
                         operador no entiende por qué los botones dicen otra cosa. -->
                    <Border Style="{StaticResource TarjetaInterna}"
                            IsVisible="{Binding EstaEditandoBorrador}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Grid.Column="0"
                                   Text="{Binding BorradorEnEdicion, StringFormat='Editando el borrador {0}'}"
                                   Style="{StaticResource TextoDato}"
                                   VerticalOptions="Center" />
                            <Button Grid.Column="1"
                                    Text="Cancelar"
                                    Style="{StaticResource BotonSecundario}"
                                    Command="{Binding CancelarEdicionBorradorCommand}" />
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <!-- Los textos cambian al editar: con un borrador abierto no se crea
                             nada, se actúa sobre él. Un botón que dice "Guardar incidencia"
                             haría creer que quedan dos registros del mismo hecho. -->
                        <Button Grid.Column="0"
                                Text="{Binding TextoBotonPrimario}"
                                Style="{StaticResource BotonPrimario}"
                                Command="{Binding GuardarIncidenciaCommand}" />
                        <Button Grid.Column="1"
                                Text="{Binding TextoBotonSecundario}"
                                Style="{StaticResource BotonSecundario}"
                                Command="{Binding GuardarBorradorCommand}" />
                    </Grid>

                    <!-- Qué pasó al enviar la incidencia recién guardada (JTT-1401). NO usa
                         el estilo de error: quedarse en la cola por falta de señal es el
                         funcionamiento normal en campo, y pintarlo en rojo enseñaría al
                         operador a ignorar los mensajes rojos. -->
                    <Label Text="{Binding MensajeEnvio}"
                           Style="{StaticResource TextoSecundario}"
                           IsVisible="{Binding HayMensajeEnvio}" />

                    <Button Text="Eliminar borrador"
                            Style="{StaticResource BotonSecundario}"
                            IsVisible="{Binding EstaEditandoBorrador}"
                            Command="{Binding EliminarBorradorCommand}" />

                </VerticalStackLayout>
            </Border>

            <!-- Los borradores viven fuera de la cola: nunca se envían -->
            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Borradores pendientes" Style="{StaticResource TituloTarjeta}" />

                    <Label Text="Sin borradores pendientes."
                           Style="{StaticResource TextoSecundario}"
                           IsVisible="{Binding HayBorradores, Converter={StaticResource InvertirBooleano}}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Borradores}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:RegistroColaVista">
                                <!-- Tocar un borrador lo abre en el formulario de arriba
                                     (JTT-1399 CA 8). Se reutiliza esa pantalla en vez de
                                     abrir otra: editar un borrador es exactamente capturar,
                                     y duplicarla obligaría a mantener dos veces las mismas
                                     validaciones. -->
                                <Border Style="{StaticResource TarjetaInterna}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CapturaViewModel}}, Path=AbrirBorradorCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding ClaveLocal}" FontAttributes="Bold" FontSize="13"
                                                   TextColor="{StaticResource TextoTitulo}" />
                                            <Label Text="{Binding TextoDatos}" Style="{StaticResource TextoDato}" />
                                        </VerticalStackLayout>
                                        <!-- Que se puede tocar tiene que verse: sin esta pista,
                                             la lista parece de solo lectura. -->
                                        <Label Grid.Column="1"
                                               Text="Abrir"
                                               Style="{StaticResource TextoSecundario}"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
