<?xml version="1.0" encoding="UTF-8" ?>
<!-- El acceso queda fuera de las pestañas: sin sesión no se ve ninguna -->
<Shell
    x:Class="AppOperador.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vistas="clr-namespace:AppOperador.Mobile.Vistas"
    Shell.FlyoutBehavior="Disabled"
    Shell.BackgroundColor="{StaticResource Vino}"
    Shell.ForegroundColor="{StaticResource Blanco}"
    Shell.TitleColor="{StaticResource Blanco}"
    Shell.TabBarBackgroundColor="{StaticResource Blanco}"
    Shell.TabBarTitleColor="{StaticResource Vino}"
    Shell.TabBarUnselectedColor="{StaticResource TextoEtiqueta}"
    Title="App Operador">

    <!-- La primera ruta es con la que arranca la app -->
    <ShellContent
        Route="acceso"
        ContentTemplate="{DataTemplate vistas:AccesoPage}"
        Shell.NavBarIsVisible="False" />

    <TabBar Route="principal">

        <!-- Iconos .png aunque la fuente sea .svg: el SDK los convierte. Android los tiñe con TabBarTitleColor -->
        <ShellContent
            Title="Inicio"
            Icon="tab_inicio.png"
            Route="inicio"
            ContentTemplate="{DataTemplate vistas:InicioPage}" />

        <ShellContent
            Title="Captura"
            Icon="tab_captura.png"
            Route="captura"
            ContentTemplate="{DataTemplate vistas:CapturaPage}" />

        <ShellContent
            Title="Cola"
            Icon="tab_cola.png"
            Route="cola"
            ContentTemplate="{DataTemplate vistas:ColaPage}" />

        <ShellContent
            Title="Perfil"
            Icon="tab_perfil.png"
            Route="perfil"
            ContentTemplate="{DataTemplate vistas:PerfilPage}" />

    </TabBar>

</Shell>
