<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>AppOperador.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>AppOperador.Mobile</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.appoperador.mobile</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<!-- Ambiente: Local (omisión), Desarrollo, QA o Simulado. Ver docs/guia-generar-apk-por-ambiente.md -->
	<PropertyGroup>
		<Ambiente Condition="'$(Ambiente)' == ''">Local</Ambiente>
		<DefineConstants Condition="'$(Ambiente)' == 'Desarrollo'">$(DefineConstants);AMBIENTE_DESARROLLO</DefineConstants>
		<DefineConstants Condition="'$(Ambiente)' == 'QA'">$(DefineConstants);AMBIENTE_QA</DefineConstants>
		<DefineConstants Condition="'$(Ambiente)' == 'Simulado'">$(DefineConstants);AMBIENTE_SIMULADO</DefineConstants>
	</PropertyGroup>

	<!-- Un ambiente mal escrito falla aquí en vez de compilar como Local -->
	<!-- Exportación de la base en claro, solo para diagnóstico: se enciende a mano y apagada no llega al paquete. Ver docs/guia-exportar-base-datos.md -->
	<PropertyGroup>
		<HabilitarExportacionBaseDatos Condition="'$(HabilitarExportacionBaseDatos)' == '' AND '$(Configuration)' == 'Debug'">true</HabilitarExportacionBaseDatos>
		<HabilitarExportacionBaseDatos Condition="'$(HabilitarExportacionBaseDatos)' == ''">false</HabilitarExportacionBaseDatos>
		<DefineConstants Condition="'$(HabilitarExportacionBaseDatos)' == 'true'">$(DefineConstants);EXPORTAR_BASE_DATOS</DefineConstants>
	</PropertyGroup>

	<!-- Copia del token para autorizarse en Swagger: solo diagnóstico y apagada no llega al paquete. Ver docs/guia-token-para-swagger.md -->
	<PropertyGroup>
		<HabilitarCopiaToken Condition="'$(HabilitarCopiaToken)' == '' AND '$(Configuration)' == 'Debug'">true</HabilitarCopiaToken>
		<HabilitarCopiaToken Condition="'$(HabilitarCopiaToken)' == ''">false</HabilitarCopiaToken>
		<DefineConstants Condition="'$(HabilitarCopiaToken)' == 'true'">$(DefineConstants);COPIAR_TOKEN</DefineConstants>
	</PropertyGroup>

	<Target Name="ValidarAmbiente" BeforeTargets="BeforeBuild">
		<Error Condition="'$(Ambiente)' != 'Local' AND '$(Ambiente)' != 'Desarrollo' AND '$(Ambiente)' != 'QA' AND '$(Ambiente)' != 'Simulado'"
		       Text="Ambiente '$(Ambiente)' no reconocido. Use Local, Desarrollo, QA o Simulado." />
		<!-- Un valor que no sea true o false falla aquí en vez de compilar apagado -->
		<Error Condition="'$(HabilitarExportacionBaseDatos)' != 'true' AND '$(HabilitarExportacionBaseDatos)' != 'false'"
		       Text="HabilitarExportacionBaseDatos '$(HabilitarExportacionBaseDatos)' no es valido. Use true o false." />
		<Error Condition="'$(HabilitarCopiaToken)' != 'true' AND '$(HabilitarCopiaToken)' != 'false'"
		       Text="HabilitarCopiaToken '$(HabilitarCopiaToken)' no es valido. Use true o false." />
	</Target>

	<!-- Deja una copia del APK nombrada con ambiente y fecha; -exportaBD y -token marcan los paquetes de diagnóstico -->
	<Target Name="NombrarPaqueteEntregable" AfterTargets="Publish"
	        Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PropertyGroup>
			<_SufijoExportacion Condition="'$(HabilitarExportacionBaseDatos)' == 'true'">-exportaBD</_SufijoExportacion>
			<_SufijoToken Condition="'$(HabilitarCopiaToken)' == 'true'">-token</_SufijoToken>
			<_PaqueteFirmado>$(PublishDir)$(ApplicationId)-Signed.apk</_PaqueteFirmado>
			<_PaqueteEntregable>$(PublishDir)AppOperador-$(Ambiente)-$([System.DateTime]::Now.ToString('yyyy-MM-dd'))$(_SufijoExportacion)$(_SufijoToken).apk</_PaqueteEntregable>
		</PropertyGroup>
		<Copy SourceFiles="$(_PaqueteFirmado)" DestinationFiles="$(_PaqueteEntregable)"
		      Condition="Exists('$(_PaqueteFirmado)')" />
		<Message Importance="high" Condition="Exists('$(_PaqueteEntregable)')"
		         Text="Paquete para entregar: $(_PaqueteEntregable)" />
		<!-- Message y no Warning: la compilación con exportación es legítima y el proyecto no tiene advertencias -->
		<Message Importance="high" Condition="Exists('$(_PaqueteEntregable)') AND '$(HabilitarExportacionBaseDatos)' == 'true'"
		         Text="AVISO: este paquete puede exportar la base local sin cifrar. No dejarlo instalado en un telefono de operacion." />
		<Message Importance="high" Condition="Exists('$(_PaqueteEntregable)') AND '$(HabilitarCopiaToken)' == 'true'"
		         Text="AVISO: este paquete puede copiar el token de la sesion. No dejarlo instalado en un telefono de operacion." />
	</Target>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="13.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<!-- Obsoletos: nada arrastra ya lib.e_sqlite3. Quitarlos exige verificar los cuatro destinos -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" ExcludeAssets="native;runtime" />
		<PackageReference Include="SQLitePCLRaw.lib.e_sqlite3.android" Version="2.1.12" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android'">
		<PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\AppOperador.Aplicacion\AppOperador.Aplicacion.csproj" />
	  <ProjectReference Include="..\AppOperador.Infrastructure\AppOperador.Infrastructure.csproj" />
	</ItemGroup>

</Project>
