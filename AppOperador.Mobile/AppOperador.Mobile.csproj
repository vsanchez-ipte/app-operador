<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>AppOperador.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>AppOperador.Mobile</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.appoperador.mobile</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<!--
		A qué ambiente apunta el paquete. Se elige al compilar y no editando código:

		  dotnet publish AppOperador.Mobile -f net10.0-android -c Release -p:Ambiente=Desarrollo

		Valores admitidos:
		  · Local      (omisión) API en el equipo de quien desarrolla
		  · Desarrollo             servidor de desarrollo de IPTE
		  · QA                     servidor de calidad de IPTE, donde prueba el equipo de QA
		  · Simulado               sin servidor, recorrido completo contra simuladores

		El nombre se traduce a un símbolo de compilación que lee Configuracion/AmbienteDeCompilacion.cs.
	-->
	<PropertyGroup>
		<Ambiente Condition="'$(Ambiente)' == ''">Local</Ambiente>
		<DefineConstants Condition="'$(Ambiente)' == 'Desarrollo'">$(DefineConstants);AMBIENTE_DESARROLLO</DefineConstants>
		<DefineConstants Condition="'$(Ambiente)' == 'QA'">$(DefineConstants);AMBIENTE_QA</DefineConstants>
		<DefineConstants Condition="'$(Ambiente)' == 'Simulado'">$(DefineConstants);AMBIENTE_SIMULADO</DefineConstants>
	</PropertyGroup>

	<!--
		Un ambiente mal escrito compilaría como Local sin avisar, y el paquete saldría
		apuntando a un servidor que no es el que se pidió. Mejor que reviente aquí.
	-->
	<!--
		Exportacion de la base local a una copia SQLite legible, para revisarla con una
		herramienta de escritorio:

		  dotnet publish AppOperador.Mobile -f net10.0-android -c Release -p:Ambiente=QA -p:HabilitarExportacionBaseDatos=true

		Es una capacidad de diagnostico y no una funcion del producto. Va en su propia
		propiedad y no en el ambiente a proposito: derivarla de QA haria que todo paquete de
		QA pudiera dejar la base en claro sin que nadie lo hubiera pedido. Hay que encenderla
		a mano, paquete por paquete.

		Encendida, el perfil muestra el boton "Exportar base de datos". Apagada, ni la clase
		que exporta ni el boton llegan al paquete: el simbolo se apaga tambien en
		AppOperador.Infrastructure, que es donde vive la implementacion.

		En Debug queda encendida por omision. Las pruebas de integracion cubren la
		exportacion y se compilan en Debug, asi que apagarla ahi obligaria a pasar la
		propiedad en cada "dotnet test". En Release siempre hay que pedirla.
	-->
	<PropertyGroup>
		<HabilitarExportacionBaseDatos Condition="'$(HabilitarExportacionBaseDatos)' == '' AND '$(Configuration)' == 'Debug'">true</HabilitarExportacionBaseDatos>
		<HabilitarExportacionBaseDatos Condition="'$(HabilitarExportacionBaseDatos)' == ''">false</HabilitarExportacionBaseDatos>
		<DefineConstants Condition="'$(HabilitarExportacionBaseDatos)' == 'true'">$(DefineConstants);EXPORTAR_BASE_DATOS</DefineConstants>
	</PropertyGroup>

	<Target Name="ValidarAmbiente" BeforeTargets="BeforeBuild">
		<Error Condition="'$(Ambiente)' != 'Local' AND '$(Ambiente)' != 'Desarrollo' AND '$(Ambiente)' != 'QA' AND '$(Ambiente)' != 'Simulado'"
		       Text="Ambiente '$(Ambiente)' no reconocido. Use Local, Desarrollo, QA o Simulado." />
		<!--
			Un "-p:HabilitarExportacionBaseDatos=1" o "=True " compilaria como apagado sin
			avisar, y el paquete saldria sin la capacidad que se pidio.
		-->
		<Error Condition="'$(HabilitarExportacionBaseDatos)' != 'true' AND '$(HabilitarExportacionBaseDatos)' != 'false'"
		       Text="HabilitarExportacionBaseDatos '$(HabilitarExportacionBaseDatos)' no es valido. Use true o false." />
	</Target>

	<!--
		Nombre del paquete que se entrega: AppOperador-<Ambiente>-<aaaa-MM-dd>[-exportaBD].apk

		El SDK de Android nombra el APK con el identificador de la aplicacion
		(com.companyname.appoperador.mobile-Signed.apk), que no dice a que ambiente apunta ni
		cuando se armo. Como los paquetes se entregan por correo o carpeta compartida y se ven
		identicos entre si, al terminar la publicacion se deja al lado una copia ya nombrada.

		El sufijo "-exportaBD" marca los paquetes que pueden sacar la base de datos en claro.
		Sin el, dos paquetes del mismo ambiente y el mismo dia se llamarian igual y el segundo
		sobrescribiria al primero, que es como se acaba entregando el que exporta creyendo que
		es el normal. Va escrito y no en siglas porque quien revisa una carpeta de paquetes no
		tiene por que saber que significa "BD".

		El original no se borra: el SDK lo usa para instalar y desplegar desde el IDE.
	-->
	<Target Name="NombrarPaqueteEntregable" AfterTargets="Publish"
	        Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PropertyGroup>
			<_SufijoExportacion Condition="'$(HabilitarExportacionBaseDatos)' == 'true'">-exportaBD</_SufijoExportacion>
			<_PaqueteFirmado>$(PublishDir)$(ApplicationId)-Signed.apk</_PaqueteFirmado>
			<_PaqueteEntregable>$(PublishDir)AppOperador-$(Ambiente)-$([System.DateTime]::Now.ToString('yyyy-MM-dd'))$(_SufijoExportacion).apk</_PaqueteEntregable>
		</PropertyGroup>
		<Copy SourceFiles="$(_PaqueteFirmado)" DestinationFiles="$(_PaqueteEntregable)"
		      Condition="Exists('$(_PaqueteFirmado)')" />
		<Message Importance="high" Condition="Exists('$(_PaqueteEntregable)')"
		         Text="Paquete para entregar: $(_PaqueteEntregable)" />
		<!--
			Aviso y no Warning: la compilacion con exportacion es legitima y sale limpia, y
			meterle una advertencia romperia la linea base de cero advertencias del proyecto.
		-->
		<Message Importance="high" Condition="Exists('$(_PaqueteEntregable)') AND '$(HabilitarExportacionBaseDatos)' == 'true'"
		         Text="AVISO: este paquete puede exportar la base local sin cifrar. No dejarlo instalado en un telefono de operacion." />
	</Target>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="13.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<!--
		Fijado por NU1903 (GHSA-2m69-gcr7-jv3q): sqlite-net-pcl llega transitivamente desde
		AppOperador.Infrastructure y arrastra lib.e_sqlite3 2.1.11, vulnerable.

		En Android se excluyen los assets nativos de lib.e_sqlite3 porque ese paquete solo
		trae binarios de Linux de escritorio (glibc) y desplazan a la libreria correcta que
		aporta el .aar de lib.e_sqlite3.android (Bionic). Si entran los dos, la app compila
		e instala pero revienta al abrir la base con:
		    dlopen failed: library "libc.so.6" not found
		Explicacion completa en el .csproj de AppOperador.Infrastructure.
	-->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" ExcludeAssets="native;runtime" />
		<PackageReference Include="SQLitePCLRaw.lib.e_sqlite3.android" Version="2.1.12" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android'">
		<PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\AppOperador.Aplicacion\AppOperador.Aplicacion.csproj" />
	  <ProjectReference Include="..\AppOperador.Infrastructure\AppOperador.Infrastructure.csproj" />
	</ItemGroup>

</Project>
