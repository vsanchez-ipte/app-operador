<?xml version="1.0" encoding="utf-8"?>
<!-- La clave de la base vive en el KeyStore, que no viaja: lo restaurado en otro equipo sería ilegible. -->
<data-extraction-rules>
	<cloud-backup>
		<exclude domain="root" />
		<exclude domain="file" />
		<exclude domain="database" />
		<exclude domain="sharedpref" />
		<exclude domain="external" />
	</cloud-backup>
	<device-transfer>
		<exclude domain="root" />
		<exclude domain="file" />
		<exclude domain="database" />
		<exclude domain="sharedpref" />
		<exclude domain="external" />
	</device-transfer>
</data-extraction-rules>
