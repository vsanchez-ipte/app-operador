<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!--
			net10.0 sin plataforma existe para que AppOperador.IntegrationTests pueda
			probar los adaptadores SQLite en el escritorio. Las APIs de MAUI que dependen
			del dispositivo lanzan en este destino, por eso BaseDatosLocal admite una ruta
			explícita: las pruebas le pasan un archivo temporal y nunca tocan FileSystem.
		-->
		<TargetFrameworks>net10.0;net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<!--
		Exportación de la base a SQLite legible. El interruptor y su porqué están explicados
		en AppOperador.Mobile.csproj; aquí se repite porque el símbolo tiene que existir
		también donde vive la implementación, o el APK de Release la seguiría cargando dentro
		aunque nadie la registrara.

		Al compilar la app, la propiedad se pasa a este proyecto sola: MSBuild propaga las
		propiedades globales a los proyectos referenciados.
	-->
	<PropertyGroup>
		<HabilitarExportacionBaseDatos Condition="'$(HabilitarExportacionBaseDatos)' == '' AND '$(Configuration)' == 'Debug'">true</HabilitarExportacionBaseDatos>
		<HabilitarExportacionBaseDatos Condition="'$(HabilitarExportacionBaseDatos)' == ''">false</HabilitarExportacionBaseDatos>
		<DefineConstants Condition="'$(HabilitarExportacionBaseDatos)' == 'true'">$(DefineConstants);EXPORTAR_BASE_DATOS</DefineConstants>

		<!--
			En net10.0 va siempre, pase lo que pase con el interruptor. Ese destino no se
			distribuye: existe solo para que AppOperador.IntegrationTests pueda probar los
			adaptadores SQLite en el escritorio. Sin esta linea, un "dotnet test -c Release"
			dejaria al proyecto de pruebas sin la clase que prueba y no compilaria.
		-->
		<DefineConstants Condition="'$(TargetFramework)' == 'net10.0' AND '$(HabilitarExportacionBaseDatos)' != 'true'">$(DefineConstants);EXPORTAR_BASE_DATOS</DefineConstants>
	</PropertyGroup>

	<Target Name="ValidarExportacionBaseDatosInfraestructura" BeforeTargets="BeforeBuild">
		<Error Condition="'$(HabilitarExportacionBaseDatos)' != 'true' AND '$(HabilitarExportacionBaseDatos)' != 'false'"
		       Text="HabilitarExportacionBaseDatos '$(HabilitarExportacionBaseDatos)' no es valido. Use true o false." />
	</Target>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="sqlite-net-sqlcipher" Version="1.9.172" />
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
	</ItemGroup>

	<!--
		Ya no se fijan versiones de las librerias nativas.

		Hasta JTT-1388 la base iba con bundle_green, que arrastraba lib.e_sqlite3 2.1.11 y
		con ella la vulnerabilidad GHSA-2m69-gcr7-jv3q; como no existia bundle_green 2.1.12,
		habia que fijar a mano la version parcheada, y en Android excluir sus assets nativos
		para que el .so de glibc no desplazara al .aar de Bionic. Sin eso la app compilaba,
		instalaba y tronaba al abrir la base con "dlopen failed: library libc.so.6 not found".

		bundle_e_sqlcipher 2.1.11 usa e_sqlcipher, que no esta afectada: comprobado con
		"dotnet list package" y sus modificadores vulnerable e include-transitive, que no
		devuelven nada. El bundle gestiona sus propias librerias por plataforma, asi que el
		arreglo sobra.

		Si alguna vez se vuelve a fijar una version nativa a mano, releer esta nota antes.
	-->

	<!--
		Geometria del corredor (JTT-1395). Va incrustada en el ensamblado, no como MauiAsset,
		por dos motivos: el destino net10.0 no tiene sistema de archivos de la app y las
		pruebas de integracion la leen ahi, y un recurso incrustado no se puede perder al
		empaquetar sin que la compilacion lo note.

		Viaja dentro del paquete porque hoy no hay endpoint que la publique. El dia que lo
		haya, se cambia la implementacion de IRepositorioGeometriaCorredor y este archivo se
		queda como respaldo o desaparece; nada mas del codigo lo nombra.
	-->
	<ItemGroup>
	  <EmbeddedResource Include="Dispositivo\corredor-tijuana-tecate.csv" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\AppOperador.Aplicacion\AppOperador.Aplicacion.csproj" />
	  <ProjectReference Include="..\AppOperador.Domain\AppOperador.Domain.csproj" />
	</ItemGroup>

</Project>
