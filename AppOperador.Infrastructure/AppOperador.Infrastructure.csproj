<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- net10.0 existe para que IntegrationTests pruebe los adaptadores SQLite en el escritorio -->
		<TargetFrameworks>net10.0;net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<!-- El símbolo también tiene que existir aquí, donde vive la implementación; MSBuild propaga la propiedad -->
	<PropertyGroup>
		<HabilitarExportacionBaseDatos Condition="'$(HabilitarExportacionBaseDatos)' == '' AND '$(Configuration)' == 'Debug'">true</HabilitarExportacionBaseDatos>
		<HabilitarExportacionBaseDatos Condition="'$(HabilitarExportacionBaseDatos)' == ''">false</HabilitarExportacionBaseDatos>
		<DefineConstants Condition="'$(HabilitarExportacionBaseDatos)' == 'true'">$(DefineConstants);EXPORTAR_BASE_DATOS</DefineConstants>

		<!-- En net10.0 va siempre: ese destino no se distribuye y las pruebas necesitan la clase -->
		<DefineConstants Condition="'$(TargetFramework)' == 'net10.0' AND '$(HabilitarExportacionBaseDatos)' != 'true'">$(DefineConstants);EXPORTAR_BASE_DATOS</DefineConstants>
	</PropertyGroup>

	<Target Name="ValidarExportacionBaseDatosInfraestructura" BeforeTargets="BeforeBuild">
		<Error Condition="'$(HabilitarExportacionBaseDatos)' != 'true' AND '$(HabilitarExportacionBaseDatos)' != 'false'"
		       Text="HabilitarExportacionBaseDatos '$(HabilitarExportacionBaseDatos)' no es valido. Use true o false." />
	</Target>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="sqlite-net-sqlcipher" Version="1.9.172" />
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
	</ItemGroup>

	<!-- bundle_e_sqlcipher trae sus librerías nativas: no hace falta fijar ninguna -->

	<!-- Recurso incrustado y no MauiAsset: net10.0 no tiene sistema de archivos de la app y así no se pierde al empaquetar -->
	<ItemGroup>
	  <EmbeddedResource Include="Dispositivo\corredor-tijuana-tecate.csv" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\AppOperador.Aplicacion\AppOperador.Aplicacion.csproj" />
	  <ProjectReference Include="..\AppOperador.Domain\AppOperador.Domain.csproj" />
	</ItemGroup>

</Project>
