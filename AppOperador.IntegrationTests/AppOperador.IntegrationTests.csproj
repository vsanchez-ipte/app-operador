<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NSubstitute" Version="6.0.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    Bases de versiones anteriores, en SQL, para probar la migración contra lo que la app dejaba
    de verdad en el dispositivo. Van embebidas para que la prueba no dependa de rutas.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Fixtures\*.sql" />
  </ItemGroup>

  <!--
    A diferencia de AppOperador.UnitTests, este proyecto SÍ referencia Infrastructure:
    su razón de existir es probar los adaptadores contra una base SQLite real. La regla
    de arquitectura que aísla UnitTests se mantiene intacta.
  -->
  <ItemGroup>
    <ProjectReference Include="..\AppOperador.Domain\AppOperador.Domain.csproj" />
    <ProjectReference Include="..\AppOperador.Aplicacion\AppOperador.Aplicacion.csproj" />
    <ProjectReference Include="..\AppOperador.Infrastructure\AppOperador.Infrastructure.csproj" />
  </ItemGroup>

</Project>